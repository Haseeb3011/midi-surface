{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MIDI Surface",
  "version": "0.1.0",
  "identifier": "com.midisurface.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MIDI Surface",
        "width": 1600,
        "height": 1000,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "decorations": true,
        "acceptFirstMouse": true,
        "visible": true,
        "theme": "Dark",
        "backgroundColor": "#0a0a14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "MIDI Surface",
    "category": "Music",
    "shortDescription": "Vital-inspired touch MIDI control surface",
    "longDescription": "Touch-first MIDI control surface for Windows 2-in-1s. Pads, piano, knobs, faders, transport — sends MIDI to FL Studio / Ableton via loopMIDI.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
